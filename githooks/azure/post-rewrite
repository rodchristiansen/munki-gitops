#!/usr/bin/env bash
# HOOK_VERSION=2026.04.19
#
# ──────────────────────────────────────────────────────────────────────────────
#  post-rewrite hook  –  safety net after git rebase / git commit --amend
#
#  Git fires post-rewrite after `git rebase` and `git commit --amend`. Neither
#  is a pull, but both can re-point HEAD at pkgsinfo that references packages
#  you don't have locally.
#
#  Behaviour: delegates to post-merge with the same change-detection logic.
#  Rebases set ORIG_HEAD, which post-merge consumes naturally. Amends don't
#  change HEAD's reachable commits, so we skip those.
#
#  Env bypass: GIT_NO_VERIFY, SKIP_MUNKI_HOOKS, SKIP_POST_REWRITE, DISABLE_CUSTOM_HOOKS
# ──────────────────────────────────────────────────────────────────────────────
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=../lib/common.sh
source "$HOOK_DIR/../lib/common.sh"

check_hook_version "post-rewrite" "2026.04.19"
should_skip_hook "post-rewrite" && exit 0
link_worktree_sync_caches

REWRITE_TYPE="${1:-rebase}"
if [[ "$REWRITE_TYPE" == "amend" ]]; then
  exit 0
fi

POST_MERGE="$HOOK_DIR/post-merge"
if [[ -x "$POST_MERGE" ]]; then
  exec "$POST_MERGE" "$@"
fi
