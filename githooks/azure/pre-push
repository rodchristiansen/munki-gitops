#!/usr/bin/env bash
# HOOK_VERSION=2026.04.22
#
# ──────────────────────────────────────────────────────────────────────────────
#  pre-push hook  –  safe Azure Blob upload for Munki repo
#
#  • Gated to pushing `main` — other branches push freely, no sync.
#  • Aborts when behind origin/main (unless fast-forward succeeds).
#  • Re-runs makecatalogs as a final pre-flight.
#  • Every `azcopy sync` writes MD5 to blob metadata (--put-md5) so future
#    --compare-hash=MD5 runs have something to compare against — without it,
#    hash compares are meaningless and files re-transfer every time.
#  • Azure orphan cleanup after successful sync (capped, deployment-validated).
#  • Symlink-crossing guard refuses delete-syncs that would traverse into the
#    primary worktree's cache.
#
#  • Env bypass: GIT_NO_VERIFY, SKIP_MUNKI_HOOKS, SKIP_PRE_PUSH, DISABLE_CUSTOM_HOOKS
# ──────────────────────────────────────────────────────────────────────────────
set -euo pipefail
set -f
shopt -s nullglob

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=../lib/common.sh
source "$HOOK_DIR/../lib/common.sh"

check_hook_version "pre-push" "2026.04.22"
should_skip_hook "pre-push" && exit 0
link_worktree_sync_caches
acquire_hook_lock "pre-push" || exit 1
check_staged_binary_sizes || exit 1

# ── Configuration ──────────────────────────────────────────
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [[ -z "$REPO_ROOT" ]]; then
  REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
fi
STORAGE_ACCOUNT="${MUNKI_STORAGE_ACCOUNT:-yourstorageaccount}"
CONTAINER="${MUNKI_CONTAINER:-munki}"
STORAGE_URL="https://${STORAGE_ACCOUNT}.blob.core.windows.net/${CONTAINER}"
TENANT_ID="${MUNKI_AZURE_TENANT_ID:-}"

# Safety cap for Azure orphan deletions. The canonical-set floor inside
# cleanup_azure_orphans catches "wrong deployment path" cases; this cap
# catches the rarer case where canonical is valid but Azure drifted far
# (e.g. another admin repoclean'd hundreds of old pkgs). Surface a large
# deletion for review rather than silently nuking.
AZURE_ORPHAN_DELETION_CAP="${MUNKI_AZURE_ORPHAN_DELETION_CAP:-50}"

# ── azcopy detection ───────────────────────────────────────
if [[ -x "/opt/homebrew/bin/azcopy" ]]; then
  AZCOPY="/opt/homebrew/bin/azcopy"
elif command -v azcopy &>/dev/null; then
  AZCOPY=$(command -v azcopy)
else
  echo "ERROR: azcopy not found — install with: brew install azcopy" >&2
  exit 1
fi

# ── flags ──────────────────────────────────────────────────
FORCE_SYNC=false
DRY_RUN=false
UPLOAD_SYNC=false
TARGET_PATHS=()

while [[ $# -gt 0 ]]; do
  case $1 in
    --force)  FORCE_SYNC=true; shift ;;
    --path)   shift; [[ $# -gt 0 ]] && TARGET_PATHS+=("$1"); shift ;;
    --dry-run) DRY_RUN=true; shift ;;
    --upload|--sync) UPLOAD_SYNC=true; shift ;;
    *) shift ;;
  esac
done

# ── logging ────────────────────────────────────────────────
LOGDIR="$REPO_ROOT/.git/logs"
mkdir -p "$LOGDIR"
TODAY=$(date +%F)
LOGFILE="$LOGDIR/hook-pre-push-upload-$TODAY.log"
: >"$LOGFILE"
find "$LOGDIR" -name 'hook-pre-push-upload-*.log' -mtime +7 -exec rm {} \; 2>/dev/null || true

log() {
  local ts; ts=$(date '+%Y-%m-%d %H:%M:%S')
  printf '%s %s\n' "$ts" "$*" | tee -a "$LOGFILE"
}

next_index() {
  local max=0
  for f in "$LOGDIR"/hook-pre-push-upload-"$TODAY"-*; do
    [[ -e $f ]] || continue
    local n=${f##*-}; n=${n%.log}
    (( n > max )) && max=$n
  done
  echo $((max+1))
}

# ── Azure auth (with optional auto-login) ─────────────────
azure_login() {
  if [[ -n "$TENANT_ID" ]]; then
    az login --tenant "$TENANT_ID"
  else
    az login
  fi
}

check_azure_auth() {
  local timeout_cmd=""
  if command -v gtimeout &>/dev/null; then
    timeout_cmd="gtimeout 10"
  else
    timeout_cmd="perl -e 'alarm shift @ARGV; exec @ARGV' 10"
  fi

  if ! eval "$timeout_cmd az account show &>/dev/null"; then
    log "Azure CLI not authenticated — attempting login..."
    if ! azure_login; then
      log "ERROR: az login failed. Please authenticate manually and retry."
      exit 1
    fi
  fi

  if ! eval "$timeout_cmd az account get-access-token --resource https://storage.azure.com &>/dev/null"; then
    log "Azure storage token expired — re-running az login..."
    if ! azure_login; then
      log "ERROR: az login failed. Please authenticate manually and retry."
      exit 1
    fi
  fi
}

# ── pkgsinfo helpers ───────────────────────────────────────
extract_location_from_pkgsinfo() {
  local pkgsinfo_file="$1"
  local location
  location=$(grep -E '^installer_item_location:' "$pkgsinfo_file" 2>/dev/null | \
    head -1 | sed 's/^installer_item_location:[[:space:]]*//' | tr -d '"'"'" || true)
  if [[ -z "$location" ]]; then
    location=$(grep -A1 '<key>installer_item_location</key>' "$pkgsinfo_file" 2>/dev/null | \
      grep '<string>' | sed 's/.*<string>\(.*\)<\/string>.*/\1/' | head -1 || true)
  fi
  echo "$location"
}

build_canonical_pkg_list_committed() {
  local pkgsinfo_dir="$REPO_ROOT/deployment/pkgsinfo"
  {
    grep -rhE '^\s*installer_item_location:\s*' "$pkgsinfo_dir" \
      --include="*.yaml" --include="*.yml" 2>/dev/null | \
      sed -E 's/^\s*installer_item_location:\s*//' | tr -d '"'"'" | sed 's/^[[:space:]]*//' || true
    grep -rhA1 '<key>installer_item_location</key>' "$pkgsinfo_dir" 2>/dev/null | \
      grep '<string>' | sed -E 's/.*<string>(.*)<\/string>.*/\1/' || true
  } | sort -u
}

# ── Azure orphan cleanup (floor + hard cap + deployment check) ─
cleanup_azure_orphans() {
  log "Building canonical package list from committed pkgsinfo..."
  local canonical_file; canonical_file=$(mktemp)
  build_canonical_pkg_list_committed > "$canonical_file"
  local canonical_count; canonical_count=$(wc -l < "$canonical_file" | tr -d ' ')
  log "  $canonical_count packages referenced in committed pkgsinfo"

  # SAFETY FLOOR: a tiny canonical set almost always means we resolved the
  # wrong deployment dir or are in a sparse scratch workspace. Refuse to
  # prune rather than nuking the blob catalog.
  if (( canonical_count < MUNKI_MIN_PKGSINFO_FOR_VALID )); then
    log "ABORT orphan cleanup: canonical set has only $canonical_count pkgsinfo entries (min $MUNKI_MIN_PKGSINFO_FOR_VALID)."
    log "  Check the deployment path or raise MUNKI_MIN_PKGSINFO_FOR_VALID if your fleet is small."
    rm -f "$canonical_file"
    return 0
  fi

  # Also cross-reference the deployment structure itself.
  if ! validate_munki_deployment "$REPO_ROOT/deployment"; then
    log "ABORT orphan cleanup: '$REPO_ROOT/deployment' does not validate as a Munki deployment."
    rm -f "$canonical_file"
    return 0
  fi

  local azure_list; azure_list=$(mktemp)
  "$AZCOPY" list "$STORAGE_URL/deployment/pkgs/" 2>/dev/null | \
    grep -v '^INFO:' | \
    grep -E '\.(pkg|dmg|zip|mobileconfig);' | \
    sed 's/;.*//' | \
    sort -u > "$azure_list" || true
  local azure_count; azure_count=$(wc -l < "$azure_list" | tr -d ' ')
  log "  $azure_count packages in Azure blob storage"

  local orphans; orphans=$(mktemp)
  comm -23 "$azure_list" "$canonical_file" > "$orphans"
  local orphan_count; orphan_count=$(wc -l < "$orphans" | tr -d ' ')

  # HARD CAP: never silently mass-delete from Azure. Surface large deletions
  # for manual review.
  if (( orphan_count > AZURE_ORPHAN_DELETION_CAP )); then
    log "ABORT orphan cleanup: $orphan_count Azure orphans exceed cap ($AZURE_ORPHAN_DELETION_CAP)."
    log "  First 20 orphans that would have been deleted:"
    head -20 "$orphans" | while IFS= read -r o; do log "    - $o"; done
    (( orphan_count > 20 )) && log "    ... and $((orphan_count - 20)) more"
    log "  Review manually or raise MUNKI_AZURE_ORPHAN_DELETION_CAP if intentional."
    rm -f "$canonical_file" "$azure_list" "$orphans"
    return 0
  fi

  if (( orphan_count > 0 )); then
    log "Found $orphan_count orphan package(s) in Azure:"
    head -20 "$orphans" | while IFS= read -r o; do log "  - $o"; done
    (( orphan_count > 20 )) && log "  ... and $((orphan_count - 20)) more"

    if [[ "$DRY_RUN" != "true" ]]; then
      log "Batch-deleting $orphan_count orphans..."
      "$AZCOPY" remove "$STORAGE_URL/deployment/pkgs/" \
        --list-of-files "$orphans" \
        --log-level="ERROR" --output-level="essential" 2>&1 | grep -v "^INFO:" | tee -a "$LOGFILE" || true

      local local_deleted=0
      while IFS= read -r o; do
        [[ -z "$o" ]] && continue
        local lp="$REPO_ROOT/deployment/pkgs/$o"
        if [[ -f "$lp" ]]; then
          rm -f "$lp"
          local_deleted=$((local_deleted + 1))
        fi
      done < "$orphans"
      (( local_deleted > 0 )) && log "  -> removed $local_deleted orphan(s) locally"
    else
      log "[DRY RUN] Would delete $orphan_count orphans from Azure and locally"
    fi
  else
    log "No orphan packages in Azure"
  fi
  rm -f "$canonical_file" "$azure_list" "$orphans"
}

# ── change detection ───────────────────────────────────────
detect_changes() {
  if [[ "$FORCE_SYNC" == "true" ]]; then echo "all"; return; fi
  if [[ "$UPLOAD_SYNC" == "true" ]]; then echo "upload"; return; fi

  local remote_ref="origin/$(git symbolic-ref --short HEAD)"
  local changed_files=""
  if git show-ref --verify --quiet "refs/remotes/$remote_ref"; then
    changed_files=$(git diff --name-only "$remote_ref"..HEAD -- deployment/ 2>/dev/null || true)
  elif git rev-parse HEAD~1 >/dev/null 2>&1; then
    changed_files=$(git diff --name-only HEAD~1 HEAD -- deployment/ 2>/dev/null || true)
  else
    echo "all"; return
  fi

  if [[ -z "$changed_files" ]]; then
    echo "none"; return
  fi

  local paths=""
  if echo "$changed_files" | grep -qE "^deployment/(pkgs|pkgsinfo)/"; then
    paths+="pkgs "
  fi
  if echo "$changed_files" | grep -qE "^deployment/icons/"; then
    paths+="icons "
  fi
  paths=$(echo "$paths" | xargs)
  [[ -z "$paths" ]] && echo "none" || echo "$paths"
}

# ── targeted path upload ───────────────────────────────────
if [[ ${#TARGET_PATHS[@]} -gt 0 ]]; then
  log ">> targeted path upload — ${#TARGET_PATHS[@]} path(s)"
  check_azure_auth
  export AZCOPY_AUTO_LOGIN_TYPE="AZCLI"
  for target_path in "${TARGET_PATHS[@]}"; do
    [[ "$target_path" != deployment/* ]] && target_path="deployment/pkgs/$target_path"
    log "  → uploading: $target_path"
    "$AZCOPY" copy "$REPO_ROOT/$target_path" "$STORAGE_URL/$target_path" \
      --put-md5 \
      --log-level="ERROR" --output-level="essential" 2>&1 | tee -a "$LOGFILE" || true
  done
  log 'Targeted path upload complete'
  mv "$LOGFILE" "${LOGFILE%.*}-$(next_index).log"
  exit 0
fi

# ── branch gating ──────────────────────────────────────────
current_branch=$(git symbolic-ref --quiet --short HEAD || true)
if [[ "$current_branch" != "main" && "$current_branch" != "master" ]]; then
  log "Skipping upload — branch '$current_branch' is not main/master."
  mv "$LOGFILE" "${LOGFILE%.*}-$(next_index).log"
  exit 0
fi

# ── fast-forward guard ─────────────────────────────────────
git fetch --quiet origin "$current_branch" 2>/dev/null || true
behind=$(git rev-list --count HEAD..origin/"$current_branch" 2>/dev/null || echo 0)
if (( behind > 0 )); then
  log "Local $current_branch is $behind commit(s) behind origin — pulling with --ff-only"
  if git pull --ff-only origin "$current_branch"; then
    log "Fast-forward successful — now at $(git rev-parse --short HEAD)"
  else
    log "PUSH CANCELLED: non-FF merge needed. Run: git pull --rebase origin $current_branch"
    exit 1
  fi
fi

log "On branch '$current_branch' — checking for changes"

# ── makecatalogs re-validation ─────────────────────────────
DEPLOYMENT="$REPO_ROOT/deployment"
if ! command -v makecatalogs &>/dev/null; then
  log "WARNING: makecatalogs not found — skipping pkgsinfo validation"
else
  log "Running makecatalogs to validate pkgsinfo..."
  MAKECATALOGS_OUTPUT=$(mktemp)
  makecatalogs --silent "$DEPLOYMENT" 2>&1 | tee "$MAKECATALOGS_OUTPUT" | tee -a "$LOGFILE"

  PARSE_ERRORS=$(grep -E "Unexpected error reading" "$MAKECATALOGS_OUTPUT" || true)
  if [[ -n "$PARSE_ERRORS" ]]; then
    log "PUSH BLOCKED: parse errors in pkgsinfo"
    log "$PARSE_ERRORS"
    rm -f "$MAKECATALOGS_OUTPUT"
    mv "$LOGFILE" "${LOGFILE%.*}-$(next_index).log"
    exit 1
  fi

  MISSING_PKGS=$(grep -E "WARNING:.*refers to missing installer item:" "$MAKECATALOGS_OUTPUT" || true)
  if [[ -n "$MISSING_PKGS" ]]; then
    WARNING_COUNT=$(echo "$MISSING_PKGS" | wc -l | tr -d ' ')
    log "Found $WARNING_COUNT missing package(s) — attempting auto-download"

    PATH_ARGS=()
    while IFS= read -r line; do
      p=$(echo "$line" | sed 's/.*refers to missing installer item: //')
      PATH_ARGS+=(--path "$p")
    done <<< "$MISSING_PKGS"

    "$HOOK_DIR/post-merge" "${PATH_ARGS[@]}" 2>&1 | tee -a "$LOGFILE"

    rm -f "$MAKECATALOGS_OUTPUT"
    MAKECATALOGS_OUTPUT=$(mktemp)
    makecatalogs --silent "$DEPLOYMENT" 2>&1 | tee "$MAKECATALOGS_OUTPUT" | tee -a "$LOGFILE"
    MISSING_RECHECK=$(grep -E "WARNING:.*refers to missing installer item:" "$MAKECATALOGS_OUTPUT" || true)
    if [[ -n "$MISSING_RECHECK" ]]; then
      STILL=$(echo "$MISSING_RECHECK" | wc -l | tr -d ' ')
      log "PUSH BLOCKED: $STILL package(s) still missing after download"
      log "$(echo "$MISSING_RECHECK" | sed 's/.*refers to missing installer item: /  - /')"
      rm -f "$MAKECATALOGS_OUTPUT"
      mv "$LOGFILE" "${LOGFILE%.*}-$(next_index).log"
      exit 1
    fi
    log "All missing packages downloaded"
  fi
  rm -f "$MAKECATALOGS_OUTPUT"
fi

# ── change detection → sync ────────────────────────────────
changed_paths=$(detect_changes)
if [[ "$changed_paths" == "none" ]]; then
  log "No binary changes — skipping sync"
  mv "$LOGFILE" "${LOGFILE%.*}-$(next_index).log"
  exit 0
fi

check_azure_auth
export AZCOPY_AUTO_LOGIN_TYPE="AZCLI"

log "On branch '$current_branch' — syncing: $changed_paths"

# Cleanup temp files
find "$REPO_ROOT" -name ".azDownload*" -type f -delete 2>/dev/null || true

# SAFETY: refuse any upload-sync path that crosses a symlink (linked worktree).
# --delete-destination=true would traverse the link to enumerate local files
# and delete Azure blobs not present in the sparse worktree view.
if ! assert_safe_delete_sync "$REPO_ROOT/deployment/pkgs" "pre-push upload sync"; then
  log "Aborting pre-push — push from the primary worktree instead."
  mv "$LOGFILE" "${LOGFILE%.*}-$(next_index).log"
  exit 1
fi

# Common flags — --put-md5 is REQUIRED. Without it, future syncs can't
# compare hashes and re-transfer every file every time.
AZCOPY_SYNC_FLAGS=(
  --delete-destination=true
  --exclude-pattern="*.DS_Store"
  --put-md5
  --compare-hash=MD5
  --log-level="ERROR"
  --output-level="essential"
)
[[ "$DRY_RUN" == "true" ]] && AZCOPY_SYNC_FLAGS+=(--dry-run)

if [[ "$changed_paths" == "all" ]] || echo "$changed_paths" | grep -q "pkgs"; then
  log '>> syncing deployment/pkgs'
  "$AZCOPY" sync "$REPO_ROOT/deployment/pkgs" "$STORAGE_URL/deployment/pkgs/" \
    "${AZCOPY_SYNC_FLAGS[@]}" 2>&1 | tee -a "$LOGFILE"
  cleanup_azure_orphans
fi

if [[ "$changed_paths" == "all" ]] || echo "$changed_paths" | grep -q "icons"; then
  log '>> syncing deployment/icons'
  "$AZCOPY" sync "$REPO_ROOT/deployment/icons" "$STORAGE_URL/deployment/icons/" \
    "${AZCOPY_SYNC_FLAGS[@]}" 2>&1 | tee -a "$LOGFILE"
fi

if [[ "$changed_paths" == "upload" ]]; then
  log '>> upload mode — full hash-based sync'
  for sub in pkgs icons; do
    log ">> syncing deployment/$sub"
    "$AZCOPY" sync "$REPO_ROOT/deployment/$sub" "$STORAGE_URL/deployment/$sub/" \
      "${AZCOPY_SYNC_FLAGS[@]}" 2>&1 | tee -a "$LOGFILE"
  done
  cleanup_azure_orphans
fi

log 'pre-push complete'
mv "$LOGFILE" "${LOGFILE%.*}-$(next_index).log"
