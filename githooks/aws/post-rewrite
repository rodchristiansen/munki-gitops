#!/usr/bin/env bash
# HOOK_VERSION=2026.04.19
#
# ──────────────────────────────────────────────────────────────────────────────
#  post-rewrite hook  –  safety net after git rebase / git commit --amend (AWS)
#
#  Delegates to post-merge. Skips amends (they don't change reachable commits).
# ──────────────────────────────────────────────────────────────────────────────
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=../lib/common.sh
source "$HOOK_DIR/../lib/common.sh"

check_hook_version "post-rewrite" "2026.04.19"
should_skip_hook "post-rewrite" && exit 0
link_worktree_sync_caches

REWRITE_TYPE="${1:-rebase}"
[[ "$REWRITE_TYPE" == "amend" ]] && exit 0

POST_MERGE="$HOOK_DIR/post-merge"
[[ -x "$POST_MERGE" ]] && exec "$POST_MERGE" "$@"
