#!/usr/bin/env bash
# HOOK_VERSION=2026.04.19
#
# ──────────────────────────────────────────────────────────────────────────────
#  pre-commit hook  –  validates Munki pkgsinfo before committing (AWS S3)
#
#  Identical guards to the Azure variant; only the cloud-specific auto-download
#  path differs (delegates to aws/post-merge instead of azure/post-merge).
#
#  See githooks/README.md for full documentation.
# ──────────────────────────────────────────────────────────────────────────────
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=../lib/common.sh
source "$HOOK_DIR/../lib/common.sh"

check_hook_version "pre-commit" "2026.04.19"
should_skip_hook "pre-commit" && exit 0
link_worktree_sync_caches
acquire_hook_lock "pre-commit" || exit 1
check_staged_binary_sizes || exit 1

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [[ -z "$REPO_ROOT" ]]; then
  REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
fi
DEPLOYMENT="$REPO_ROOT/deployment"
DIALOG="/usr/local/bin/dialog"
LINT_SCRIPT="$HOOK_DIR/../lib/pkgsinfo-lint.py"
ORPHAN_DELETION_CAP="${MUNKI_ORPHAN_DELETION_CAP:-10}"

if ! command -v makecatalogs &>/dev/null; then
  echo "ERROR: makecatalogs not found — install from https://github.com/munki/munki" >&2
  exit 1
fi

USE_DIALOG=false
[[ -x "$DIALOG" ]] && USE_DIALOG=true

# ── M1: structural pkgsinfo linter ─────────────────────────
if [[ -x "$LINT_SCRIPT" ]] && command -v python3 >/dev/null 2>&1; then
  LINT_OUTPUT=$(mktemp)
  LINT_EXIT=0
  python3 "$LINT_SCRIPT" "$REPO_ROOT" 2> "$LINT_OUTPUT" || LINT_EXIT=$?
  cat "$LINT_OUTPUT" >&2 || true
  if [[ $LINT_EXIT -ne 0 ]]; then
    if [[ "$USE_DIALOG" == "true" ]]; then
      LINT_REPORT=$(cat "$LINT_OUTPUT")
      "$DIALOG" --title "Commit Blocked: pkgsinfo Structural Errors" \
        --icon "SF=exclamationmark.triangle.fill,palette=white,red,red" --iconsize 80 \
        --message "Static validation caught structural issues:\n\n\`\`\`\n${LINT_REPORT}\n\`\`\`" \
        --button1text "OK" --messagefont "size=12" --width 780 --height 560 --moveable || true
    fi
    rm -f "$LINT_OUTPUT"
    exit 1
  fi
  rm -f "$LINT_OUTPUT"
fi

# ── makecatalogs ───────────────────────────────────────────
echo "Running makecatalogs to validate pkgsinfo..."
MAKECATALOGS_OUTPUT=$(mktemp)
MAKECATALOGS_EXIT=0
makecatalogs --silent "$DEPLOYMENT" 2>&1 | tee "$MAKECATALOGS_OUTPUT" || MAKECATALOGS_EXIT=$?

PARSE_ERRORS=$(grep -E "Unexpected error reading" "$MAKECATALOGS_OUTPUT" || true)
if [[ -n "$PARSE_ERRORS" ]]; then
  ERROR_FILES=$(echo "$PARSE_ERRORS" | sed 's/.*Unexpected error reading \([^:]*\):.*/\1/' | sort -u)
  ERROR_COUNT=$(echo "$ERROR_FILES" | wc -l | tr -d ' ')
  if [[ "$USE_DIALOG" == "true" ]]; then
    ERROR_LIST=$(echo "$ERROR_FILES" | sed 's/^/• /')
    "$DIALOG" --title "Commit Blocked: malformed pkgsinfo" \
      --icon "SF=xmark.circle.fill,palette=white,red,red" --iconsize 80 \
      --message "**makecatalogs** found **${ERROR_COUNT}** pkgsinfo file(s) that cannot be parsed.\n\n${ERROR_LIST}" \
      --button1text "OK" --messagefont "size=14" --width 700 --height 400 --moveable || true
  fi
  rm -f "$MAKECATALOGS_OUTPUT"
  echo "COMMIT BLOCKED: Fix parse error(s) before committing."
  echo "$ERROR_FILES"
  exit 1
fi

# ── M2 + M3: orphan pkg cleanup (main/master only, capped) ─
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [[ "$CURRENT_BRANCH" == "main" || "$CURRENT_BRANCH" == "master" ]]; then
  PKGS_DIR="$DEPLOYMENT/pkgs"
  PKGSINFO_DIR="$DEPLOYMENT/pkgsinfo"
  if [[ -d "$PKGS_DIR" && -d "$PKGSINFO_DIR" ]]; then
    CANONICAL_FILE=$(mktemp)
    grep -rhE '^[[:space:]]*installer_item_location:[[:space:]]*' "$PKGSINFO_DIR" \
      --include="*.yaml" --include="*.yml" 2>/dev/null | \
      sed -E 's/^[[:space:]]*installer_item_location:[[:space:]]*//' | \
      tr -d '"'"'" | sed 's/^[[:space:]]*//' >> "$CANONICAL_FILE" || true
    grep -rhA1 '<key>installer_item_location</key>' "$PKGSINFO_DIR" 2>/dev/null | \
      grep '<string>' | sed -E 's/.*<string>(.*)<\/string>.*/\1/' >> "$CANONICAL_FILE" || true
    sort -u -o "$CANONICAL_FILE" "$CANONICAL_FILE"

    ORPHANS=()
    while IFS= read -r -d '' pkg_file; do
      rel_path="${pkg_file#$PKGS_DIR/}"
      if ! grep -qxF "$rel_path" "$CANONICAL_FILE" 2>/dev/null; then
        ORPHANS+=("$rel_path")
      fi
    done < <(find "$PKGS_DIR" -type f \( -name "*.pkg" -o -name "*.dmg" -o -name "*.zip" -o -name "*.mobileconfig" \) -print0 2>/dev/null)

    ORPHAN_COUNT=${#ORPHANS[@]}
    rm -f "$CANONICAL_FILE"

    if (( ORPHAN_COUNT > ORPHAN_DELETION_CAP )); then
      echo ""
      echo "COMMIT BLOCKED: ${ORPHAN_COUNT} orphan package(s) found (cap is ${ORPHAN_DELETION_CAP})."
      echo "  Likely cause: partial branch, stale pkgs, or YAML parse error."
      echo "  Sample:"
      for o in "${ORPHANS[@]:0:15}"; do echo "    • $o"; done
      (( ORPHAN_COUNT > 15 )) && echo "    ... and $((ORPHAN_COUNT - 15)) more"
      exit 1
    fi

    if (( ORPHAN_COUNT > 0 )); then
      echo ""
      echo "Found ${ORPHAN_COUNT} orphan package(s) — cleaning up:"
      for o in "${ORPHANS[@]}"; do
        echo "  • $o"
        rm -f "$PKGS_DIR/$o"
      done
      find "$PKGS_DIR" -type d -empty -delete 2>/dev/null || true
    fi
  fi
else
  echo "[pre-commit] Skipping orphan cleanup (branch '$CURRENT_BRANCH' is not main/master)."
fi

# ── missing pkgs → auto-download via aws/post-merge ────────
MISSING_PKGS=$(grep -E "WARNING:.*refers to missing installer item:" "$MAKECATALOGS_OUTPUT" || true)
if [[ -n "$MISSING_PKGS" ]]; then
  WARNING_COUNT=$(echo "$MISSING_PKGS" | wc -l | tr -d ' ')
  MISSING_PKG_PATHS=()
  while IFS= read -r line; do
    p=$(echo "$line" | sed 's/.*refers to missing installer item: //')
    MISSING_PKG_PATHS+=("$p")
  done <<< "$MISSING_PKGS"

  STAGED_PKGSINFO_COUNT=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null \
    | grep -cE '^deployment/pkgsinfo/.*\.(yaml|yml)$' || true)
  STAGED_PKGSINFO_COUNT=${STAGED_PKGSINFO_COUNT:-0}
  MAX_AUTO_DOWNLOAD=$(( STAGED_PKGSINFO_COUNT * 5 ))
  (( MAX_AUTO_DOWNLOAD < 25 )) && MAX_AUTO_DOWNLOAD=25

  if (( WARNING_COUNT > MAX_AUTO_DOWNLOAD )); then
    echo ""
    echo "COMMIT CANCELLED: ${WARNING_COUNT} missing packages exceeds safe auto-download limit (${MAX_AUTO_DOWNLOAD})."
    echo "  Run: githooks/aws/post-merge --sync"
    exit 1
  fi

  echo "Found ${WARNING_COUNT} missing package(s). Downloading from S3..."
  PATH_ARGS=()
  for p in "${MISSING_PKG_PATHS[@]}"; do
    PATH_ARGS+=(--path "$p")
  done

  POST_MERGE_HOOK="$HOOK_DIR/post-merge"
  if [[ -x "$POST_MERGE_HOOK" ]]; then
    "$POST_MERGE_HOOK" "${PATH_ARGS[@]}"
  fi

  echo "Re-validating pkgsinfo after download..."
  rm -f "$MAKECATALOGS_OUTPUT"
  MAKECATALOGS_OUTPUT=$(mktemp)
  makecatalogs --silent "$DEPLOYMENT" 2>&1 | tee "$MAKECATALOGS_OUTPUT"

  MISSING_RECHECK=$(grep -E "WARNING:.*refers to missing installer item:" "$MAKECATALOGS_OUTPUT" || true)
  if [[ -n "$MISSING_RECHECK" ]]; then
    STILL=$(echo "$MISSING_RECHECK" | wc -l | tr -d ' ')
    rm -f "$MAKECATALOGS_OUTPUT"
    echo "COMMIT BLOCKED: $STILL package(s) still missing after download."
    exit 1
  fi
fi

if [[ $MAKECATALOGS_EXIT -ne 0 ]]; then
  rm -f "$MAKECATALOGS_OUTPUT"
  echo "COMMIT BLOCKED: makecatalogs failed with exit code $MAKECATALOGS_EXIT"
  exit 1
fi

rm -f "$MAKECATALOGS_OUTPUT"
echo "pkgsinfo validation passed"
exit 0
